# MongoDB connection string used by the "Book a Site Visit" form
# (app/api/book-visit/route.ts) to store leads. Leave unset or as the
# dummy value in .env.local during local dev — the API route detects
# it and skips persistence with a console warning instead of failing.
MONGODB_URI=
MONGODB_DB=amaya

# /admin dashboard — protects the Book a Visit leads table.
# ADMIN_SESSION_SECRET signs the login session cookie; generate a long
# random string for it (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Sends a notification email (name/phone/date) on every Book a Visit
# submission (lib/email.ts, sent via Gmail SMTP through nodemailer).
# EMAIL_USER/EMAIL_PASS must be a Gmail address + App Password (not the
# account password — generate one at myaccount.google.com/apppasswords).
# EMAIL is the recipient the notification is sent to.
EMAIL_USER=
EMAIL_PASS=
EMAIL=

# ImageKit — stores Blog/Media featured images and rich-text editor
# uploads (app/api/admin/blogs/upload/route.ts). Get these from the
# ImageKit dashboard under Developer Options. IMAGEKIT_PRIVATE_KEY must
# never be exposed client-side — it's only read in server-side API routes.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Set to "false" to temporarily skip OTP verification on Book a Visit and
# Get a Quote (leads save immediately after the details form) — see
# lib/otpConfig.ts. Leave unset/"true" to require verification as normal.
NEXT_PUBLIC_OTP_ENABLED=

# Firebase Phone Auth — sends/verifies the OTP that gates Book a Visit and
# Get a Quote (components/OtpStep.tsx). The NEXT_PUBLIC_* values come from
# the Firebase console: Project settings -> your Web app -> SDK setup and
# configuration. They are not secret (safe in client-side JS).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — used server-side (lib/firebaseAdmin.ts) to
# independently verify the ID token the client gets after a successful
# OTP, before a lead is saved. Generate at Project settings -> Service
# accounts -> Generate new private key, then paste the ENTIRE downloaded
# JSON file as a single-line string here. This one IS secret — never
# commit it or expose it client-side.
FIREBASE_SERVICE_ACCOUNT_KEY=

# IndexNow — pings Bing (and other participating search engines) the
# moment a Blog post or published Media item is created/updated, so it
# can be crawled without waiting for the next scheduled sitemap check
# (lib/indexNow.ts). Not a secret — generate any random hex string and
# it must also be saved verbatim as public/<key>.txt (see that file).
INDEXNOW_KEY=
